# Copy to .env for Docker Compose. Do not commit real secrets.
POSTGRES_DB=pro_trading_ds
POSTGRES_USER=pro_trading_ds
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+asyncpg://pro_trading_ds:change-this-password@db:5432/pro_trading_ds
REDIS_URL=redis://redis:6379/0
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=fake-384
AI_EMBEDDING_DIMENSION=384
AI_EMBEDDING_TIMEOUT_SECONDS=30
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_COMMIT=local
